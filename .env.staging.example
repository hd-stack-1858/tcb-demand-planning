# Copy this file to .env.staging and fill in the staging DB credentials.
# Used by setup/sync_prod_to_staging.py.
#
# Get STAGING_DB_URL from:
#   Supabase Dashboard → staging project → Settings → Database → Connection string
#   Choose "Session pooler" (port 5432) or "Direct connection" (port 5432).
#   Use the password you set when creating the staging project.

STAGING_DB_URL=postgresql://postgres.YOUR_STAGING_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
